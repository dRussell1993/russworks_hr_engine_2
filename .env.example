RUSSWORKS_RUNTIME_MODE=local
RUSSWORKS_RUN_DATE=2026-06-13
RUSSWORKS_PROVIDER_MODE=csv
RUSSWORKS_DATA_ROOT=/app/data/daily
RUSSWORKS_OUTPUT_ROOT=/app/data/outputs
RUSSWORKS_CONFIG_PATH=/app/config/russworks_config.yaml
RUSSWORKS_REPORT_VOLUME=/app/data

# Scheduled daily execution metadata. The compose file does not run a scheduler
# daemon; use your host scheduler, cron, or GitHub Actions to call the daily
# service at this time.
RUSSWORKS_SCHEDULE_ENABLED=false
RUSSWORKS_DAILY_RUN_TIME_UTC=15:00
RUSSWORKS_TIMEZONE=UTC

# Optional live provider configuration. Leave blank for CSV/fallback mode.
RUSSWORKS_MLB_STATS_BASE_URL=
RUSSWORKS_MLB_STATS_API_KEY=
RUSSWORKS_BASEBALL_SAVANT_BASE_URL=
RUSSWORKS_BASEBALL_SAVANT_API_KEY=
RUSSWORKS_WEATHER_BASE_URL=
RUSSWORKS_WEATHER_API_KEY=
RUSSWORKS_BALLPARK_BASE_URL=
RUSSWORKS_BALLPARK_API_KEY=
RUSSWORKS_PROVIDER_TIMEOUT_SECONDS=10
RUSSWORKS_PROVIDER_MAX_RETRIES=2
